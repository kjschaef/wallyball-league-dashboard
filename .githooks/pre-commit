#!/usr/bin/env bash
#
# Pre-commit hook: File Token Limit Checker
# Prevents files over 5,000 tokens (Tokens = bytes / 4, i.e., > 20,000 bytes).
# Runs ONLY on staged files.
# Ignores files not authored by agents (lockfiles, codegen, media, migrations, etc.).
# Provides explicit instructions on how to split files in the error message.
#

set -eo pipefail

MAX_TOKENS=5000
BYTES_PER_TOKEN=4
MAX_BYTES=$((MAX_TOKENS * BYTES_PER_TOKEN)) # 20,000 bytes

# Terminal color styling
if [ -t 1 ]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  BLUE='\033[0;34m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  DIM='\033[2m'
  NC='\033[0m'
else
  RED=''
  GREEN=''
  YELLOW=''
  BLUE=''
  CYAN=''
  BOLD=''
  DIM=''
  NC=''
fi

# Locate repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo -e "${RED}Error: Not a git repository.${NC}" >&2
  exit 1
fi
cd "$REPO_ROOT"

# Function to check whether a file is ignored (not authored by agents)
is_ignored() {
  local file="$1"

  # 1. Custom .tokenignore / .agent-token-ignore file in repo root
  local ignore_file=""
  if [ -f "$REPO_ROOT/.tokenignore" ]; then
    ignore_file="$REPO_ROOT/.tokenignore"
  elif [ -f "$REPO_ROOT/.agent-token-ignore" ]; then
    ignore_file="$REPO_ROOT/.agent-token-ignore"
  fi

  if [ -n "$ignore_file" ]; then
    while IFS= read -r pattern || [ -n "$pattern" ]; do
      # Strip carriage return and leading/trailing whitespace
      pattern="$(echo "$pattern" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [ -z "$pattern" ] && continue
      [[ "$pattern" == \#* ]] && continue

      # Match directory pattern
      if [[ "$pattern" == */ ]]; then
        local dir_prefix="${pattern%/}"
        if [[ "$file" == "$dir_prefix"/* ]] || [[ "$file" == */"$dir_prefix"/* ]]; then
          return 0
        fi
      elif [[ "$pattern" == /* ]]; then
        # Anchored to repo root
        local root_pattern="${pattern#/}"
        if [[ "$file" == $root_pattern ]]; then
          return 0
        fi
      else
        # Glob or basename match
        if [[ "$file" == $pattern ]] || [[ "$file" == */$pattern ]] || [[ "$file" == $pattern/* ]] || [[ "$file" == */$pattern/* ]]; then
          return 0
        fi
      fi
    done < "$ignore_file"
  fi

  # 2. Package manager lockfiles
  case "$file" in
    pnpm-lock.yaml|package-lock.json|yarn.lock|bun.lockb|composer.lock|Cargo.lock|poetry.lock|Pipfile.lock|flake.lock|*.lock)
      return 0
      ;;
  esac

  # 3. Known generated context, embeddings, Drizzle migrations, and framework artifacts
  case "$file" in
    agent-context/*.json|agent-context/*)
      return 0
      ;;
    lib/rules-embeddings.json)
      return 0
      ;;
    migrations/*|drizzle/*)
      return 0
      ;;
    next-env.d.ts)
      return 0
      ;;
    *.generated.*|*.g.*|*.d.ts.map|*.map|*.tsbuildinfo|*.min.js|*.min.css|*.bundle.js)
      return 0
      ;;
    coverage/*|playwright-report/*|test-results/*|.next/*|dist/*|build/*|out/*)
      return 0
      ;;
  esac

  # 4. Binary, media, documents, and attached assets
  case "$file" in
    *.png|*.jpg|*.jpeg|*.gif|*.svg|*.ico|*.webp|*.avif|*.bmp|*.tiff|\
    *.pdf|*.doc|*.docx|*.xls|*.xlsx|*.ppt|*.pptx|\
    *.mp3|*.wav|*.ogg|*.flac|*.mp4|*.webm|*.mov|*.avi|*.mkv|\
    *.woff|*.woff2|*.ttf|*.eot|*.otf|\
    *.zip|*.tar|*.gz|*.tgz|*.bz2|*.7z|*.rar|\
    attached_assets/*)
      return 0
      ;;
  esac

  # 5. Quick binary check (detect non-text binary files)
  if command -v file >/dev/null 2>&1; then
    local mime
    mime=$(git show ":$file" 2>/dev/null | head -c 4096 | file -b --mime-encoding - 2>/dev/null || true)
    if [ "$mime" = "binary" ]; then
      return 0
    fi
  fi

  # 6. Content-based codegen markers in the first 30 lines
  local header
  header=$(git show ":$file" 2>/dev/null | head -n 30) || true
  if [ -n "$header" ]; then
    if echo "$header" | grep -Ei "(@generated|do not edit|do not modify|code generated by|auto-generated|autogenerated|this file was generated|this file is generated)" >/dev/null 2>&1; then
      return 0
    fi
  fi

  return 1
}

# Parse CLI flags (default: staged files only for git pre-commit)
CHECK_ALL=0
if [ "$1" = "--all" ]; then
  CHECK_ALL=1
fi

# Collect files to audit
files_to_check=()
if [ "$CHECK_ALL" -eq 1 ]; then
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && files_to_check+=("$f")
  done < <(git ls-files 2>/dev/null || true)
else
  # Default: Run only on staged files (excluding deletions)
  while IFS= read -r -d '' f; do
    [ -n "$f" ] && files_to_check+=("$f")
  done < <(git diff --cached --name-only -z --diff-filter=d 2>/dev/null || true)
fi

# If no files to check, exit successfully
if [ ${#files_to_check[@]} -eq 0 ]; then
  exit 0
fi

# Audit each file
violations=()
has_react_violation=0
has_api_violation=0
has_test_violation=0
has_general_violation=0

for file in "${files_to_check[@]}"; do
  # Skip ignored files (lockfiles, codegen, binaries, etc.)
  if is_ignored "$file"; then
    continue
  fi

  # Retrieve exact size in bytes of staged content (or working copy if checking all)
  bytes=""
  if [ "$CHECK_ALL" -eq 1 ]; then
    if [ -f "$file" ]; then
      bytes=$(wc -c < "$file" | tr -d '[:space:]')
    fi
  else
    bytes=$(git cat-file -s ":$file" 2>/dev/null || true)
    if [ -z "$bytes" ] && [ -f "$file" ]; then
      bytes=$(wc -c < "$file" | tr -d '[:space:]')
    fi
  fi

  [ -z "$bytes" ] && continue

  # Check if size exceeds 5,000 tokens (Tokens = bytes / 4, so > 20,000 bytes)
  if [ "$bytes" -gt "$MAX_BYTES" ]; then
    tokens=$(( (bytes + BYTES_PER_TOKEN - 1) / BYTES_PER_TOKEN ))
    excess_tokens=$(( tokens - MAX_TOKENS ))
    excess_bytes=$(( bytes - MAX_BYTES ))
    violations+=("$file|$bytes|$tokens|$excess_tokens|$excess_bytes")

    # Flag violation categories for customized guidance
    case "$file" in
      *.tsx|*.jsx)
        has_react_violation=1
        ;;
      */api/*|*route.ts|*route.js)
        has_api_violation=1
        ;;
      *.test.*|*.spec.*|*__tests__/*)
        has_test_violation=1
        ;;
      *)
        has_general_violation=1
        ;;
    esac
  fi
done

# If no violations, pass cleanly
if [ ${#violations[@]} -eq 0 ]; then
  exit 0
fi

# Print detailed rejection message with splitting instructions
echo ""
echo -e "${RED}${BOLD}================================================================================${NC}"
echo -e "${RED}${BOLD}🚨 COMMIT BLOCKED: Staged files exceed token limit (> 5,000 tokens)${NC}"
echo -e "${RED}${BOLD}================================================================================${NC}"
echo ""
echo -e "  ${BOLD}Formula:${NC} Tokens = bytes / 4"
echo -e "  ${BOLD}Maximum Limit:${NC} ${YELLOW}5,000 tokens${NC} (20,000 bytes)"
echo ""
echo -e "${BOLD}Violating staged files (${#violations[@]} file(s)):${NC}"
echo ""

for item in "${violations[@]}"; do
  IFS='|' read -r v_file v_bytes v_tokens v_excess_tokens v_excess_bytes <<< "$item"
  echo -e "  ${RED}❌ ${v_file}${NC}"
  echo -e "     Size:   ${BOLD}${v_tokens}${NC} tokens (${v_bytes} bytes)"
  echo -e "     Excess: ${RED}+${v_excess_tokens} tokens${NC} (+${v_excess_bytes} bytes over limit)"
  echo ""
done

echo -e "${CYAN}${BOLD}--------------------------------------------------------------------------------${NC}"
echo -e "${CYAN}${BOLD}EXPLICIT INSTRUCTIONS: HOW TO SPLIT FILES${NC}"
echo -e "${CYAN}${BOLD}--------------------------------------------------------------------------------${NC}"
echo ""
echo -e "Large files degrade AI reasoning, slow code reviews, and increase merge conflicts."
echo -e "Follow these instructions to split your file(s) into modules under 5,000 tokens:"
echo ""

if [ "$has_react_violation" -eq 1 ] || [ "$has_general_violation" -eq 1 ]; then
  echo -e "${YELLOW}${BOLD}⚛️  For React / UI Components (.tsx, .jsx):${NC}"
  echo -e "  1. ${BOLD}Decompose UI Elements:${NC} Extract sub-components (modals, forms, card"
  echo -e "     items, table rows, toolbar controls) into individual files in"
  echo -e "     'app/components/' or a dedicated subfolder."
  echo -e "  2. ${BOLD}Extract Custom Hooks:${NC} Move state management, side effects,"
  echo -e "     and data fetching into custom hooks (e.g., 'app/hooks/use[Feature].ts')."
  echo -e "  3. ${BOLD}Extract Types & Constants:${NC} Move component interfaces, props,"
  echo -e "     constants, and style helpers to a separate 'types.ts' or 'constants.ts'."
  echo ""
fi

if [ "$has_api_violation" -eq 1 ]; then
  echo -e "${YELLOW}${BOLD}🌐 For API Routes / Handlers (route.ts):${NC}"
  echo -e "  1. ${BOLD}Extract Service Logic:${NC} Move database queries, calculations, and"
  echo -e "     third-party integrations into dedicated service modules in 'app/lib/'."
  echo -e "  2. ${BOLD}Extract Validation:${NC} Move Zod validation schemas and request types"
  echo -e "     into a separate 'schema.ts' or 'types.ts' file."
  echo -e "  3. ${BOLD}Keep Handlers Thin:${NC} Route handlers should only parse inputs,"
  echo -e "     call domain services, and return the HTTP response."
  echo ""
fi

if [ "$has_test_violation" -eq 1 ]; then
  echo -e "${YELLOW}${BOLD}🧪 For Test Suites (.test.ts, .spec.ts):${NC}"
  echo -e "  1. ${BOLD}Split by Feature / Endpoint:${NC} Divide large test files by HTTP method"
  echo -e "     or user journey (e.g., 'matches.get.test.ts', 'matches.post.test.ts')."
  echo -e "  2. ${BOLD}Extract Fixtures & Mocks:${NC} Move large mock datasets, factory functions,"
  echo -e "     and shared test setup into '__mocks__/' or test helper files."
  echo ""
fi

if [ "$has_general_violation" -eq 1 ] || [ "$has_react_violation" -eq 0 -a "$has_api_violation" -eq 0 -a "$has_test_violation" -eq 0 ]; then
  echo -e "${YELLOW}${BOLD}📦 For General Logic & Utility Modules (.ts, .js):${NC}"
  echo -e "  1. ${BOLD}Single Responsibility Principle:${NC} Break multi-purpose files into cohesive,"
  echo -e "     focused submodules (e.g., 'calculations.ts', 'formatters.ts', 'filters.ts')."
  echo -e "  2. ${BOLD}Folder-as-Module Pattern:${NC} Turn 'large-module.ts' into a directory"
  echo -e "     'large-module/' with an 'index.ts' re-exporting the split files so callers"
  echo -e "     do not need import path changes."
  echo -e "  3. ${BOLD}Extract Types:${NC} Relocate interfaces and type aliases to 'types.ts'."
  echo ""
fi

echo -e "${YELLOW}${BOLD}⚙️  If this is an auto-generated or machine-managed file:${NC}"
echo -e "  • Add a generator comment at the top of the file: '// @generated' or"
echo -e "    '/* DO NOT EDIT - Generated by <tool> */'."
echo -e "  • Or add the file path or pattern to '.tokenignore' in the repository root."
echo ""
echo -e "${CYAN}${BOLD}--------------------------------------------------------------------------------${NC}"
echo -e "${CYAN}${BOLD}HOW TO PROCEED${NC}"
echo -e "${CYAN}${BOLD}--------------------------------------------------------------------------------${NC}"
echo -e "  1. Unstage the offending file(s):"
for item in "${violations[@]}"; do
  IFS='|' read -r v_file _ _ _ _ <<< "$item"
  echo -e "     ${DIM}git reset HEAD ${v_file}${NC}"
done
echo -e "  2. Split the file(s) into smaller modules (< 5,000 tokens / 20,000 bytes each)."
echo -e "  3. Re-stage the split files and commit:"
echo -e "     ${DIM}git add <new-files> <modified-files>${NC}"
echo -e "     ${DIM}git commit${NC}"
echo ""
echo -e "${RED}${BOLD}================================================================================${NC}"
echo ""

exit 1
